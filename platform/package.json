{
  "name": "toys-agency-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/index.js",
    "dev": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply TOYS_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply TOYS_DB --remote",
    "deploy": "wrangler deploy",
    "pages:build": "node scripts/build-pages.mjs",
    "pages:deploy": "npm run pages:build && wrangler pages deploy dist --project-name toys-agency-dashboard --branch main --force"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}

