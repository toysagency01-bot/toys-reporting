{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toys-agency-platform-mvp-local",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "TOYS_DB",
      "database_name": "toys-agency-mvp-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "APP_NAME": "TOYS Agency Platform — Local MVP",
    "MVP_VIEW_PROJECTS": "housevip-cxp7,demo-commerce-mvp",
    "MVP_EDITOR_PROJECTS": "housevip-cxp7"
  },
  "observability": {
    "enabled": false
  }
}
