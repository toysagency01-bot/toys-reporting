{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toys-agency-platform",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "TOYS_DB",
      "database_name": "toys-agency",
      "database_id": "d4a52154-5b79-49fb-af07-37e9228c7172",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["15 4 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "TOYS Agency Platform"
  }
}

