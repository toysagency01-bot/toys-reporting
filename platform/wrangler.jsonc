{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toys-agency-platform",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "TOYS_DB",
      "database_name": "toys-agency",
      "database_id": "d4a52154-5b79-49fb-af07-37e9228c7172",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["15 4 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "TOYS Agency Platform",
    "WEEKLY_ACCESS_SHA256": "0d48224e8240072cada34bddc9d80271a707827876f069132aa95055f8c93d64"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}

